{
  "name": "perspective-parquet",
  "version": "0.1.2",
  "description": "Parquet viewer for perspective in JupyterLab",
  "repository": "git@github.com:timkpaine/perspective-parquet.git",
  "author": "the perspective-parquet authors <t.paine154@gmail.com>",
  "license": "Apache-2.0",
  "keywords": [
    "jupyter",
    "jupyterlab",
    "jupyterlab-extension"
  ],
  "main": "lib/index.js",
  "type": "module",
  "files": [
    "lib/**/*.{d.ts,eot,gif,html,jpg,js,js.map,json,png,svg,woff2,ttf}",
    "style/**/*.css"
  ],
  "jupyterlab": {
    "extension": "src/index.js",
    "webpackConfig": "./webpack.config.cjs",
    "outputDir": "../perspective_parquet/labextension",
    "discovery": {
      "server": {
        "base": {
          "name": "perspective-parquet"
        },
        "managers": [
          "pip"
        ]
      }
    }
  },
  "scripts": {
    "build:babel": "babel src/ --source-maps --out-dir lib/",
    "build:extension": "mkdirp ../perspective_parquet/extension/ && cpy --flat 'src/extension/*' '../perspective_parquet/extension/'",
    "build:nbextension": "mkdirp ../perspective_parquet/nbextension/static/ && cpy --flat 'src/notebook.js' '../perspective_parquet/nbextension/static/'",
    "build:labextension": "rimraf ../perspective_parquet/labextension && jupyter labextension build .",
    "build": "pnpm clean && pnpm build:babel && pnpm build:extension && pnpm build:labextension && pnpm build:nbextension",
    "clean": "rimraf lib",
    "fix": "oxlint --fix src/ tests/ && oxfmt --write \"src/**/*.js\" \"tests/**/*.js\"",
    "lint": "oxlint src/ tests/ && oxfmt --check \"src/**/*.js\" \"tests/**/*.js\"",
    "preinstall": "npx only-allow pnpm",
    "prepublishOnly": "pnpm run build",
    "test": "jest --coverage --collectCoverageFrom=src/*.{js}"
  },
  "dependencies": {
    "@finos/perspective": "^3.8.0",
    "@finos/perspective-viewer": "^3.8.0",
    "@finos/perspective-viewer-d3fc": "^3.8.0",
    "@finos/perspective-viewer-datagrid": "^3.8.0",
    "@jupyterlab/application": "^4.6.3",
    "@jupyterlab/apputils": "^4.7.3",
    "@jupyterlab/notebook": "^4.6.3",
    "@jupyterlab/services": "^7.6.3",
    "@lumino/disposable": "^2.1.6",
    "parquet-wasm": "0.7.2"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.4",
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@finos/perspective-esbuild-plugin": "^3.2.1",
    "@jupyterlab/builder": "^4.5.10",
    "arraybuffer-loader": "^1.0.8",
    "babel-jest": "^30.5.1",
    "babel-loader": "^10.1.1",
    "cpy-cli": "^7.0.0",
    "css-loader": "^7.1.5",
    "eslint": "^10.10.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-json": "^5.0.0",
    "eslint-plugin-prettier": "^5.5.6",
    "html-webpack-plugin": "^5.6.8",
    "isomorphic-fetch": "^3.0.0",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "jest-junit": "^17.0.0",
    "jest-transform-css": "^6.0.3",
    "mkdirp": "^3.0.1",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "rimraf": "^6.1.3",
    "style-loader": "^4.0.0"
  }
}
